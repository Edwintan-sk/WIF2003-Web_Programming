MONGO_URI=your_mongodb_connection_string
PORT=5050
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=local_dev_secret_123
JWT_EXPIRES_IN=1d
VITE_API_BASE_URL=http://localhost:5050

CLOUDINARY_CLOUD_NAME=<your registered cloud name>
CLOUDINARY_API_KEY=<your cloudinary api key>
CLOUDINARY_API_SECRET=<your cloudinary api secret>

# ── Optional email alerts ───────────────────────────────────────────────
# Leave these blank to keep email OFF. In-app notifications still work; when
# SMTP is not configured, email alerts are simply logged to the console.
# To enable real emails (e.g. Gmail), fill all of SMTP_HOST/USER/PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KP EYE <no-reply@kpeye.local>
